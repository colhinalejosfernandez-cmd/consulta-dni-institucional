# Copia este archivo como .env. Completa sus valores en tu computadora.
# No agregues el archivo .env a GitHub.

PUERTO=3000
NODE_ENV=development

# Usuario para entrar a esta web (distinto de la cuenta de PIDE)
USUARIO_ACCESO=
# Ejecuta npm run crear-clave para generar estos valores
CLAVE_ACCESO_HASH=
CLAVE_SESION=

# Datos de acceso autorizados por la entidad para consultar PIDE
DNI_USUARIO_PIDE=
RUC_ENTIDAD_PIDE=
CLAVE_PIDE=

# Activar solo cuando un administrador configure un proxy HTTPS de confianza
CONFIAR_PROXY=false
# Si hay proxy inverso, indica la dirección pública (opcional)
ORIGEN_APLICACION=
